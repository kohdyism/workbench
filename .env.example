# Public URL of this deployment, no trailing slash. Must match the redirect URIs you register.
APP_URL=https://your-workbench.vercel.app

# Postgres (Neon or Vercel Postgres). Set DATABASE_SSL=disable for a local database without TLS.
DATABASE_URL=postgres://user:password@host/db
# DATABASE_SSL=disable

# Secrets. Generate with:  openssl rand -base64 32
SESSION_SECRET=
ENCRYPTION_KEY=

# Google OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra app registration (accounts in any organisation + personal Microsoft accounts)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_SCORING_MODEL=claude-haiku-5-5
# ANTHROPIC_DRAFT_MODEL=claude-sonnet-5-5
# Emails scored + drafts per user per day
# AI_DAILY_LIMIT=400

# Sync window
# SYNC_DAYS=14
# SYNC_MAX=60

# Shown on /privacy
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
